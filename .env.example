# Copy to .env and fill in your key: https://openrouter.ai → Keys
# The app talks to OpenRouter (OpenAI-compatible). Free model by default.
VITE_OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Optional — keep DeepSeek as a fallback, or override the model:
# VITE_DEEPSEEK_API_KEY=sk-your-deepseek-key
# VITE_LLM_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
